# --- ОБЯЗАТЕЛЬНО ---
# Токен бота из @BotFather
BOT_TOKEN=123456:ABCDEF_your_bot_token_here

# Postgres connection string. Возьми бесплатный на neon.tech.
# Формат: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Telegram user ID администратора (тебя). Узнать: @userinfobot
# Сюда будут лететь уведомления о покупках в магазине.
ADMIN_ID=123456789

# --- ОПЦИОНАЛЬНО ---
# Публичный HTTPS-адрес твоего сервера. Нужен для кнопки "Открыть Казино" в боте.
# На Render не нужно задавать — он сам выставит RENDER_EXTERNAL_URL.
PUBLIC_URL=https://your-domain.example.com

# Порт веб-сервера. На Render не задавай — он сам выставит PORT.
WEB_PORT=8080
